# Application
APP_NAME="Gıda Nöbeti API"
APP_VERSION="1.0.0"
DEBUG=True
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database
# Docker içi: db:5432 | Lokal: localhost:5432
DATABASE_URL=postgresql+asyncpg://gidanobeti:secure_password_here@db:5432/gidanobeti_db
POSTGRES_USER=gidanobeti
POSTGRES_PASSWORD=secure_password_here
POSTGRES_DB=gidanobeti_db

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# OCR
OCR_ENABLE_GPU=false
OCR_LANGUAGES=tr,en

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Dashboard stats cache (Redis, 10 dk)
DASHBOARD_CACHE_ENABLED=True

# Logging
LOG_LEVEL=INFO

# Sentry (opsiyonel - boşsa devre dışı)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_TRACES_SAMPLE_RATE=0.1
